DB_HOST=localhost
DB_NAME=connect_crm
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Application URL (useful for links in emails, etc.)
APP_URL=http://localhost/crm_app/public

# Email settings (for PHPMailer, if used for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_SECURE=tls # or ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Connect CRM"
